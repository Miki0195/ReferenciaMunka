@model ShoreTypeViewModel

@* megadjuk, hogyan jelenjen meg a tengerpart típus *@

@{
    Func<ShoreTypeViewModel, string> shoreDisplayName = shoreType =>
    {
        switch (shoreType)
        {
            case ShoreTypeViewModel.Sandy: return "homokos";
            case ShoreTypeViewModel.Gravelly: return "kavicsos";
            case ShoreTypeViewModel.Rocky: return "sziklás";
            default: return "?";
        };
    };
}

<span>@shoreDisplayName(Model)</span>